# ══════════════════════════════════════════════════════════════════
#  NNLOMNE Notify — Variables d'environnement (exemple)
# ══════════════════════════════════════════════════════════════════
#  Copiez ce fichier en `.env.local` et remplissez les valeurs :
#
#      cp .env.local.example .env.local
#
#  Aucune variable n'est requise pour le MODE DÉMO (local) :
#  l'application fonctionne avec le stockage navigateur (localStorage)
#  et une connexion démo (admin@nnlomne.gov / password).
#
#  Le MODE FIREBASE s'active dès que NEXT_PUBLIC_FIREBASE_API_KEY
#  contient une vraie clé (≠ "AIzaSyDUMMY-...").
#
#  Documentation complète : README.md (section "Variables d'environnement")
# ══════════════════════════════════════════════════════════════════

# ── Envoi SMS (MboaSMS) ────────────────────────────────────────────
# Clé API du compte MboaSMS (obligatoire en production — côté serveur uniquement).
MBOASMS_API_KEY=ta_cle_api_mboasms

# Identifiant expéditeur affiché sur le SMS (optionnel, défaut : DocNotify).
MBOASMS_SENDER_ID=DocNotify

# ── Mode Firebase (optionnel — requis uniquement pour Firestore) ──
# ⚠️ Tant que cette clé vaut "AIzaSyDUMMY-..." (ou est absente),
#    l'application reste en MODE DÉMO LOCALE.
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyVOTRE_CLE_PUBLIQUE_FIREBASE

# Domaine d'authentification (défaut : nnlomne-notify.firebaseapp.com).
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=nnlomne-notify.firebaseapp.com

# ID du projet Firebase.
NEXT_PUBLIC_FIREBASE_PROJECT_ID=nnlomne-notify

# Bucket de stockage (optionnel).
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=nnlomne-notify.appspot.com

# ID d'expéditeur de messagerie (optionnel).
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000

# ID de l'application web (optionnel).
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:000000000000

# JSON complet du compte de service Firebase (côté serveur uniquement).
# Indispensable pour que les routes API (contacts, historique, stats)
# lisent/écrivent dans Firestore.
#
# ▶ Comment l'obtenir : Console Firebase → ⚙️ Paramètres du projet →
#   Comptes de service → Générer une nouvelle clé privée.
#
# ▶ À coller sur UNE SEULE ligne, entre guillemets simples (le JSON
#   contient des guillemets doubles) :
#
# FIREBASE_SERVICE_ACCOUNT_JSON='{"type":"service_account","project_id":"nnlomne-notify","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"firebase-adminsdk-xxxx@nnlomne-notify.iam.gserviceaccount.com", ...}'
